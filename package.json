{
  "name": "ppr-control",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "node tools/build-mammoth.js && esbuild app.js --minify --charset=utf8 --outfile=app.min.js && esbuild styles.css --minify --charset=utf8 --loader:.css=css --outfile=styles.min.css",
    "check": "npm run build && npm test",
    "dev": "node server.js",
    "start": "node server.js",
    "test": "node --test",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "html2pdf.js": "^0.14.0",
    "jsqr": "^1.4.0",
    "mammoth": "^1.10.0",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "web-push": "^3.6.7",
    "ws": "^8.18.3"
  },
  "engines": {
    "node": ">=18"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "esbuild": "^0.25.6",
    "selfsigned": "^5.5.0"
  }
}
