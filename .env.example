# Local server defaults. The application runs without this file.
NODE_ENV=development
PORT=8080
QR_PORT=8081
DATA_DIR=./data

# Use only local or dedicated test databases during development.
# DATABASE_URL=postgresql://user:password@localhost:5432/ppr_control_local
# NEON_DATABASE_URL=
# SUPABASE_DATABASE_URL=
REQUIRE_POSTGRES=false

# PostgreSQL connection tuning.
PG_POOL_SIZE=5
PG_CONNECT_TIMEOUT_MS=8000
PG_RECOVERY_INTERVAL_MS=30000

# Set a strong local-only value when testing administrator bootstrap.
# ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-local-password
